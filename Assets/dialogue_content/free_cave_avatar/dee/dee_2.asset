        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    text: I want you to learn more about it and report back to me.
    portrait: {fileID: 0}
    faceExpression: 0
    eyesExpression: 0
    soundEffect: 0
    vfx: 0
    hoverSpeed: 0
  - localizedString:
