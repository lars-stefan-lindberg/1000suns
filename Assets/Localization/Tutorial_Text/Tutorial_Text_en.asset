  m_TableData:
  - m_Id: 687346335866880
    m_Localized: Cape of the shadow-walker
    m_Metadata:
      m_Items: []
  - m_Id: 687596643540992
    m_Localized: An ancient artefact that gives its bearer telekinetic powers.
    m_Metadata:
      m_Items: []
  - m_Id: 8286608645152768
    m_Localized: Hold {0} to charge, then release
    m_Metadata:
      m_Items:
      - rid: 1605334471027195906
  - m_Id: 8286945405820928
    m_Localized: to unleash a <color=#B18FFF>SHADOW PULSE</color> that will push
      objects and enemies away. Hold longer for more power.
    m_Metadata:
      m_Items: []
  - m_Id: 30007481106161664
    m_Localized: Shadow jump
    m_Metadata:
      m_Items: []
  - m_Id: 30007590145482752
    m_Localized: Use the power of your cape to jump further.
    m_Metadata:
      m_Items: []
  - m_Id: 30007894781976576
    m_Localized: When <color=#B18FFF>fully</color> charged press {0}
    m_Metadata:
      m_Items: []
  - m_Id: 30008556349546496
    m_Localized: while running to <color=#B18FFF>SHADOW JUMP</color>.
    m_Metadata:
      m_Items: []
  - m_Id: 34092543443460096
    m_Localized: Shapeshift
    m_Metadata:
      m_Items: []
  - m_Id: 34092642240290816
    m_Localized: Transform between human and shadowbound form.
    m_Metadata:
      m_Items: []
  - m_Id: 34092883819618304
    m_Localized: Press {0} or {1}
    m_Metadata:
      m_Items: []
  - m_Id: 34093011934633984
    m_Localized: to <color=#B18FFF>SHAPESHIFT</color>.
    m_Metadata:
      m_Items: []
  - m_Id: 54782013230538752
    m_Localized: Crown of the shadow-walker
    m_Metadata:
      m_Items: []
  - m_Id: 54782217451200512
    m_Localized: An ancient artefact that gives its bearer telekinetic powers.
    m_Metadata:
      m_Items: []
  - m_Id: 54782376591482880
    m_Localized: Press and hold {0} to
    m_Metadata:
      m_Items: []
  - m_Id: 54782530400804864
    m_Localized: use <color=#B18FFF>SHADOW GRIP</color> to move objects through the
      air.
    m_Metadata:
      m_Items: []
  - m_Id: 67427268786380800
    m_Localized: Shadow tether
    m_Metadata:
      m_Items: []
  - m_Id: 67427418103603200
    m_Localized: Use the power of your crown to pull yourself towards surfaces and
      hold on to them.
    m_Metadata:
      m_Items: []
  - m_Id: 67428066639470592
    m_Localized: Press and hold {0}
    m_Metadata:
      m_Items: []
  - m_Id: 67428371963830272
    m_Localized: to latch on to surfaces within reach.
    m_Metadata:
      m_Items: []
  - m_Id: 78288217051226112
    m_Localized: '{0} - SHADOW TETHER'
    m_Metadata:
      m_Items: []
  - m_Id: 78302424350056448
    m_Localized: '{0} - Hold to tether to walls'
    m_Metadata:
      m_Items: []
  - m_Id: 78302880900046848
    m_Localized: '{0} - Wall jump while tethered'
    m_Metadata:
      m_Items: []
  - m_Id: 78303280587857920
    m_Localized: '{0} {1} - Look up/down'
    m_Metadata:
      m_Items: []
  - m_Id: 78509319337795584
    m_Localized: '{0} + {1} - SHADOW TETHER upwards'
    m_Metadata:
      m_Items: []
